# Reverse proxy: TLS + auth in front, app never exposed directly.
#
# SITE_ADDRESS with no domain of your own:
#   38-242-211-91.sslip.io      -> sslip.io resolves that to 38.242.211.91,
#                                  and Let's Encrypt will issue a real cert
#                                  for it, so you get proper HTTPS.
# With your own domain, just use it: peg.example.com
#
# Port 443 must be open. Port 80 is optional -- see below.

{
	# Port 80 is frequently already taken by an existing nginx/apache. Disabling
	# the HTTP->HTTPS redirect means Caddy never needs to bind 80, and it gets
	# its certificate over the TLS-ALPN-01 challenge on 443 instead.
	# Set CADDY_HTTP_PORT to something unused (e.g. 8080) in .env when 80 is busy.
	auto_https disable_redirects
}

{$SITE_ADDRESS} {
	encode gzip

	basic_auth {
		{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
	}

	# reverse_proxy upgrades websockets automatically, which /stream needs
	reverse_proxy btczig:5173

	log {
		output stdout
		format console
	}
}

# Front door: password auth, app never exposed directly.
#
# SITE_ADDRESS decides the mode.
#
#   http://:8888                 <- works anywhere. Password-protected, but the
#                                   traffic and password are NOT encrypted.
#                                   Use this when ports 80/443 are taken or you
#                                   have no domain.
#
#   https://peg.example.com      <- proper HTTPS with a real Let's Encrypt cert.
#                                   Requires a DOMAIN (not a bare IP) and port
#                                   443 free. Also delete the "auto_https off"
#                                   line below when using this.
#
# Why not https:// on a bare IP? No public CA issues certificates for bare IPs,
# and self-signed certs on an IP break because clients send no SNI for IP
# addresses, so the server cannot select a certificate. It fails the handshake
# outright -- that is the ERR_SSL_PROTOCOL_ERROR you get. Use a hostname.

{
	# Delete this line when SITE_ADDRESS is an https:// domain.
	auto_https off
}

{$SITE_ADDRESS} {
	encode gzip

	basic_auth {
		{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
	}

	# reverse_proxy upgrades websockets automatically, which /stream needs
	reverse_proxy btczig:5173

	log {
		output stdout
		format console
	}
}

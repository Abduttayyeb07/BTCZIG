# Copy to .env and edit:   cp .env.example .env
#
# Which interface Docker publishes the port on, and which host port.
# Change HOST_PORT if something else already has the port ("port is already
# allocated"). The container always listens on 5173 internally -- do not
# change that, or the port mapping breaks.

# Safe default: only reachable from the server itself (ssh in, or tunnel).
BIND=127.0.0.1
HOST_PORT=5173

# ---------------------------------------------------------------------------
# To reach it from anywhere:  BIND=0.0.0.0
#
# Read this first. The app has NO authentication, and POST /api/engine is a
# live control endpoint. Anyone who finds the URL can reconfigure the run,
# change capital and participation, toggle wash trading, or wipe your state
# and restart it -- including in the middle of an overnight measurement.
# It is also plain HTTP, so the traffic is unencrypted.
#
# If you accept that, use a non-obvious port and lock the firewall to your own
# IP. Better: keep BIND=127.0.0.1 and front it with Caddy/nginx + TLS + basic
# auth, or use an ssh tunnel:
#     ssh -N -L 5173:127.0.0.1:5173 user@server
# ---------------------------------------------------------------------------
# BIND=0.0.0.0
# HOST_PORT=8173

# Set to 1 when sharing the URL publicly: blocks POST /api/engine so viewers
# can watch but cannot reconfigure, reset, or wipe a run in progress.
READONLY=0
